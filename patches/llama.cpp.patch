+struct test_flash_attn_ext_causal : public test_flash_attn_ext {
+    const int64_t n_past;
+
+    test_flash_attn_ext_causal(int64_t kv, int64_t nb, int64_t n_past)
+        : test_flash_attn_ext(128, 128, 8, {4, 1}, kv, nb, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0),
+          n_past(n_past) {}
+
+    std::string vars() override {
+        return test_flash_attn_ext::vars() + "," + VARS_TO_STR1(n_past);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_flash_attn_ext::initialize_tensors(ctx);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "m") != 0) {
+                continue;
+            }
+            GGML_ASSERT(ggml_is_contiguous(t) && ggml_nelements(t) == kv*nb);
+            std::vector<ggml_fp16_t> data(kv*nb);
+            for (int64_t row = 0; row < nb; ++row) {
+                for (int64_t col = 0; col < kv; ++col) {
+                    data[row*kv + col] = ggml_fp32_to_fp16(col <= n_past + row ? 0.0f : -INFINITY);
+                }
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, data.size()*sizeof(ggml_fp16_t));
+        }
+    }
+};
